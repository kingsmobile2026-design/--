        Callback = function(v) config.spamCount = v end
    })

    SpamTab:Button({
        Title = "Execute Chat Spam (도배 시작)",
        Desc = "설정한 문구를 정해진 횟수만큼 다른 유저들에게 보이게 도배합니다.",
        Callback = function()
            task.spawn(function()
                local count = math.clamp(tonumber(config.spamCount) or 5, 1, 10)
                for _ = 1, count do
                    sendChatMessage(config.spamMessage)
                    task.wait(tonumber(config.spamDelay) or 0.5)
                end
            end)
        end
    })

    SpamTab:Button({
        Title = "Random Taunt Attack (도발 버튼)",
        Desc = "누를 때마다 3종의 도발 멘트 중 하나를 무작위 선택하여 채팅창에 도배합니다.",
        Callback = function()
            local taunts = { "고수만 오삼", "자신있는 사람만 오삼", "이길수 있는 사람?ㅋㅋ" }
            math.randomseed(os.clock() + math.random(1, 1000))
            local chosenMsg = taunts[math.random(1, #taunts)]
            sendChatMessage(chosenMsg)
        end
    })

    task.spawn(function()
        while task.wait(0.25) do
            local pGui = localPlayer:FindFirstChildOfClass("PlayerGui")
            for _, descendant in ipairs(pGui:GetDescendants()) do
                if descendant:IsA("TextLabel") and (descendant.Name == "SpectatorTipLabel" or descendant.Text:find("시작하는")) then
                    local ch = string.match(descendant.Text, "'(.-)'") or string.match(descendant.Text, '"(.-)"')
                    if ch and ch ~= "" and ch ~= _lt then
                        if DueumMap[ch] then ch = DueumMap[ch] end
                        _lt = ch
                        
                        if lastProcessedLetter ~= _lt then
                            lastProcessedLetter = _lt
                            currentSearchText = _lt
                            updateFilteredWordsView()
                            
                            if botAiActive and UserRank == "Premium" then
                                task.wait(math.random(1.0, 1.8))
                                local bestWord = nil
                                for _, w in ipairs(WordDB) do
                                    if string.sub(w, 1, string.len(_lt)) == _lt then
                                        local isMatch = false
                                        local len = utf8.len(w)
                                        local isAttack = checkIsAttackWord(w)
                                        if config.selectedFilterType == "전체" then isMatch = true
                                        elseif config.selectedFilterType == "한방단어" and isAttack then isMatch = true
                                        elseif config.selectedFilterType == "초장문" and len >= 6 then isMatch = true
                                        elseif config.selectedFilterType == "한방 초장문" and isAttack and len >= 5 then isMatch = true
                                        elseif config.selectedFilterType == "방어단어" and (MainDictMap[w] and not isAttack) then isMatch = true end
                                        
                                        if isMatch then bestWord = w break end
                                    end
                                end
                                if bestWord then sendWordToGame(bestWord) end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    updateFilteredWordsView()
end

-- =============================================================================
-- [5] 프로그레스 바 로딩 화면 구현 (JSON 배열 완벽 디코딩 대응형 엔진)
-- =============================================================================
local function runLoadingSequence()
    local LoadingScreenGui = Instance.new("ScreenGui")
    LoadingScreenGui.Name = "Gravel_BoundedTextLoadingScreen"
    LoadingScreenGui.IgnoreGuiInset = true
    LoadingScreenGui.Parent = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui") or targetGuiParent

    local MainBackground = Instance.new("Frame", LoadingScreenGui)
    MainBackground.Size = UDim2.new(1, 0, 1, 0)
    MainBackground.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainBackground.BackgroundTransparency = 0.15

    local CenterContainer = Instance.new("Frame", MainBackground)
    CenterContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    CenterContainer.Position = UDim2.new(0.5, 0, 0.5, -20)
    CenterContainer.Size = UDim2.new(0, 450, 0, 300)
    CenterContainer.BackgroundTransparency = 1

    local TitleLabel = Instance.new("TextLabel", CenterContainer)
    TitleLabel.AnchorPoint = Vector2.new(0.5, 0)
    TitleLabel.Position = UDim2.new(0.5, 0, 0, 115)
    TitleLabel.Size = UDim2.new(1, 0, 0, 35)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "Loading Engine..."
    TitleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 28

    local TextProgressBar = Instance.new("TextLabel", CenterContainer)
    TextProgressBar.AnchorPoint = Vector2.new(0.5, 0)
    TextProgressBar.Position = UDim2.new(0.5, 0, 0, 170)
    TextProgressBar.Size = UDim2.new(1, 0, 0, 25)
    TextProgressBar.BackgroundTransparency = 1
    TextProgressBar.TextColor3 = Color3.fromRGB(0, 170, 255)
    TextProgressBar.Font = Enum.Font.Code
    TextProgressBar.TextSize = 18

    local StatusLabel = Instance.new("TextLabel", CenterContainer)
    StatusLabel.AnchorPoint = Vector2.new(0.5, 0)
    StatusLabel.Position = UDim2.new(0.5, 0, 0, 205)
    StatusLabel.Size = UDim2.new(1, 0, 0, 20)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    StatusLabel.Font = Enum.Font.Gotham
    StatusLabel.TextSize = 14

    local totalLength = 30
    TextProgressBar.Text = "[" .. string.rep(" ", totalLength) .. "]"

    task.spawn(function()
        StatusLabel.Text = "Downloading Core Dictionaries & Dueum Maps..."
        local rawDueum = downloadData(urls.dueumUrl)
        if rawDueum then
            pcall(function()
                local decoded = HttpService:JSONDecode(rawDueum)
                if decoded then DueumMap = decoded end
            end)
        end

        local raw = downloadData(urls.dictUrl)
        if raw then
            local success, decodedWords = pcall(function() return HttpService:JSONDecode(raw) end)
            if success and type(decodedWords) == "table" then
                for _, cleaned in ipairs(decodedWords) do
                    if cleaned ~= "" and #cleaned > 1 then 
                        table.insert(WordDB, cleaned) 
                        MainDictMap[cleaned] = true
                    end
                end
            else
                for word in string.gmatch(raw, '"([^"]+)"') do
                    if word ~= "" and #word > 1 then
                        table.insert(WordDB, word)
                        MainDictMap[word] = true
                    end
                end
            end
        end
        table.sort(WordDB)
    end)

    local currentFilled = 0
    for i = 1, totalLength do
        currentFilled = i
        local filledPart = string.rep("|", currentFilled)
        local emptyPart = string.rep(" ", totalLength - currentFilled)
        TextProgressBar.Text = "[" .. filledPart .. emptyPart .. "]"
        StatusLabel.Text = "Injecting Typing Automata Node... " .. math.floor((i/totalLength)*100) .. "%"
        task.wait(0.04)
    end

    TweenService:Create(MainBackground, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
    TweenService:Create(TitleLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(TextProgressBar, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    local fade = TweenService:Create(StatusLabel, TweenInfo.new(0.2), {TextTransparency = 1})
    fade:Play()
    fade.Completed:Wait()

    LoadingScreenGui:Destroy()
    initializeWindUIWindow()
end

