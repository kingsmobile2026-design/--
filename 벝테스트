    MainTab:Space()
    MainTab:Paragraph({ Title = "Exploits & Security Protect", Desc = "우회 보안 로직 설정", Color = config.Gradow.uicolor.lightGreen })

    local antiKickToggle = MainTab:Toggle({ Title = "Toggle AntiKick", Desc = "Enable/disable Antikick (프리미엄 전용)", Value = false, Callback = function(v) end })
