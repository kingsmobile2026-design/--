    local antiBanToggle = MainTab:Toggle({ Title = "Toggle AntiBan", Desc = "Enable/disable AntiBan (프리미엄 전용)", Value = false, Callback = function(v) end })
    antiBanToggle.Callback = function(v)
        if UserRank ~= "Premium" then antiBanToggle:SetValue(false) showPremiumAlert() else ED_AntiBan.Enabled = v end
    end

    -- =============================================================================
    -- [Spam 탭 도배 및 도발 제어 시스템 인터페이스]
    -- =============================================================================
    SpamTab:Paragraph({ Title = "Chat Spammer Engine", Desc = "인게임 전체 유저 대상 도배 및 무작위 도발 컨트롤러", Color = config.Gradow.uicolor.lightGreen })

    SpamTab:Input({
        Title = "Spam Text Input (도배 문구 입력)",
