local function forceLoadGameTextBox()
    local plGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    local gg = plGui and plGui:FindFirstChild("GameGui")
    return gg and gg:FindFirstChild("TriesFrame") and gg.TriesFrame:FindFirstChild("TypeFrame") and gg.TriesFrame.TypeFrame:FindFirstChild("TextBox")
end

local function checkIsAttackWord(word)
    local lastChar = ""
    for _, cp in utf8.codes(word) do lastChar = utf8.char(cp) end
    if EndingKillLetters[lastChar] or CustomKillLetters[lastChar] then return true end
    local cp = utf8.codepoint(lastChar)
    if cp and cp >= SBASE and cp < SBASE + SCOUNT then
        local s = cp - SBASE
        local choIdx = math.floor(s / NCOUNT)
        local jongIdx = s % TCOUNT
        if TargetJongseiIndex[jongIdx] or DoubleJongseiIndex[jongIdx] then return true end
        if DoubleChoseongIndex[choIdx] then return true end
    end
    return false
end

local function getPriorityScore(w)
    local len = utf8.len(w)
    local isAttack = checkIsAttackWord(w)
    if isAttack and len >= 5 then return 1
    elseif isAttack then return 2
    elseif len >= 6 then return 3 end
    return 4
end

-- [공용 글로벌 채팅 서버 발사기]
local function sendChatMessage(msg)
    if msg == "" then return end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(msg) end
    else
        local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local sendMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
        if sendMsg then sendMsg:FireServer(msg, "All") end
    end
end

local function sendWordToGame(word)
    if word == "" then return end
    
    local targetBox = nil
    if UserRank == "Premium" then
        targetBox = forceLoadGameTextBox()
    else
        local currentFocus = UserInputService:GetFocusedTextBox()
        if currentFocus and currentFocus.Name == "TextBox" then
            targetBox = currentFocus
        else
            targetBox = forceLoadGameTextBox()
        end
    end
    
    if not targetBox then return end
    
    currentTypeSession = currentTypeSession + 1
    local mySession = currentTypeSession
    local targetRealSpeed = tonumber(config.typingSpeed) or 350

    pcall(function()
        if UserRank == "Premium" then
            targetBox.Text = ""
            targetBox:CaptureFocus()
        end
        
        if targetRealSpeed <= 0 then
            if mySession ~= currentTypeSession then return end
            targetBox.Text = word
        else
            local totalStates = buildTypeStates(word)
            local delayTime = 60 / (targetRealSpeed * 2.8) 
            
            for _, partialText in ipairs(totalStates) do
                if mySession ~= currentTypeSession then return end
                targetBox.Text = partialText
                task.wait(delayTime)
            end
        end
        
        if mySession ~= currentTypeSession then return end
        task.wait(0.01)
        
        -- 최종 입력 후 강제 엔터 제출 연산
        targetBox:ReleaseFocus(true) 
        FirstTurnManager.onWordAccepted(word)
        
        if ED_AntiBan.Enabled and UserRank == "Premium" then
            task.wait(0.08)
            if mySession == currentTypeSession then
                targetBox.Text = ""
                collectgarbage("collect")
            end
        end
    end)
end

